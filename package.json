{
  "name": "spem-in-alium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "oxfmt && eslint . --fix",
    "format:check": "eslint . --max-warnings=0 && oxfmt --check",
    "prepare": "husky",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "score:import": "python3 scripts/import-score.py"
  },
  "dependencies": {
    "@linaria/react": "7.0.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.0.1",
    "@wyw-in-js/vite": "1.1.0",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "oxfmt": "0.72.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "^5.1.0",
    "web-audio-engine": "^0.13.4"
  },
  "packageManager": "pnpm@10.12.4"
}
